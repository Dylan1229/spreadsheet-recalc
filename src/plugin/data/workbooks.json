{
  "about": "Ten fictional single-sheet workbooks for the spreadsheet-recalc NanoAgent plugin, written by hand for it. Every name, price and score is invented. Each cell holds its content as typed: = starts a formula, a leading ' marks text, TRUE and FALSE are booleans, a decimal such as 12 or -3.5 is a number, anything else is text. Cells are listed row by row, left to right.",
  "workbooks": [
    {
      "id": "trip-budget",
      "title": "Trip budget",
      "cells": {
        "A1": "Item",
        "B1": "Cost",
        "A2": "Flights",
        "B2": "412.5",
        "A3": "Hotel",
        "B3": "=C3*D3",
        "C3": "89.9",
        "D3": "3",
        "A4": "Rail pass",
        "B4": "included",
        "A5": "Museum",
        "A6": "Food",
        "B6": "=25*D3",
        "A8": "Total",
        "B8": "=SUM(B2:B6)",
        "A9": "Costed items",
        "B9": "=COUNT(B2:B6)",
        "A10": "Average item",
        "B10": "=AVERAGE(B2:B6)",
        "A11": "Travellers",
        "B11": "7",
        "A12": "Each",
        "B12": "=B8/B11",
        "A13": "Each, rounded",
        "B13": "=ROUND(B12,2)",
        "A14": "Over 750?",
        "B14": "=B8>750",
        "A15": "Museum each",
        "B15": "=B5/B11"
      }
    },
    {
      "id": "invoice",
      "title": "Invoice with tax and discount",
      "cells": {
        "A1": "Item",
        "B1": "Qty",
        "C1": "Price",
        "D1": "Line",
        "A2": "Widget",
        "B2": "4",
        "C2": "12.5",
        "D2": "=B2*C2",
        "A3": "Gadget",
        "B3": "3",
        "C3": "19.99",
        "D3": "=B3*C3",
        "A4": "Gizmo",
        "B4": "2",
        "C4": "7.25",
        "D4": "=B4*C4",
        "A6": "Subtotal",
        "D6": "=SUM(D2:D4)",
        "A7": "Discount",
        "D7": "=IF(D6>100,-ROUND(D6*0.1,2),0)",
        "A8": "Net",
        "D8": "=D6+D7",
        "A9": "Tax rate",
        "D9": "0.0825",
        "A10": "Tax",
        "D10": "=ROUND(D8*D9,2)",
        "A11": "Total",
        "D11": "=D8+D10",
        "A12": "Free shipping",
        "D12": "=IF(D11>=120,\"yes\",\"no\")"
      }
    },
    {
      "id": "inventory-reorder",
      "title": "Inventory reorder",
      "cells": {
        "A1": "Part",
        "B1": "Stock",
        "C1": "Reorder at",
        "A2": "Bolts",
        "B2": "120",
        "C2": "100",
        "D2": "=IF(B2<C2,\"REORDER\",\"ok\")",
        "A3": "Nuts",
        "B3": "40",
        "C3": "50",
        "D3": "=IF(B3<C3,\"REORDER\",\"ok\")",
        "A4": "Washers",
        "C4": "25",
        "D4": "=IF(B4<C4,\"REORDER\",\"ok\")",
        "A5": "Rivets",
        "B5": "n/a",
        "C5": "10",
        "D5": "=IF(B5<C5,\"REORDER\",\"ok\")",
        "A6": "Pins",
        "B6": "75",
        "C6": "75",
        "D6": "=IF(B6<C6,\"REORDER\",\"ok\")",
        "A8": "Total stock",
        "B8": "=SUM(B2:B6)",
        "A9": "Parts counted",
        "B9": "=COUNT(B2:B6)",
        "A10": "Lowest stock",
        "B10": "=MIN(B2:B6)",
        "A11": "All in stock",
        "B11": "=AND(B2>0,B3>0,B4>0)"
      }
    },
    {
      "id": "simple-interest",
      "title": "Simple interest table",
      "cells": {
        "A1": "Principal",
        "B1": "1000",
        "A2": "Rate",
        "B2": "0.035",
        "A3": "Years",
        "B3": "Interest",
        "C3": "Balance",
        "D3": "Per month",
        "A4": "1",
        "B4": "=B1*B2*A4",
        "C4": "=B1+B4",
        "D4": "=C4/(A4*12)",
        "A5": "2",
        "B5": "=B1*B2*A5",
        "C5": "=B1+B5",
        "D5": "=C5/(A5*12)",
        "A6": "5",
        "B6": "=B1*B2*A6",
        "C6": "=B1+B6",
        "D6": "=C6/(A6*12)",
        "A8": "Total interest",
        "B8": "=SUM(B4:B6)",
        "A9": "Compound, 5 years",
        "B9": "=ROUND(B1*(1+B2)^A6,2)",
        "A10": "Monthly factor",
        "B10": "=(1+B2)^(1/12)"
      }
    },
    {
      "id": "operator-precedence",
      "title": "Operator precedence",
      "cells": {
        "A1": "Formula",
        "B1": "Value",
        "A2": "-2^2",
        "B2": "=-2^2",
        "A3": "2^3^2",
        "B3": "=2^3^2",
        "A4": "-(2^2)",
        "B4": "=-(2^2)",
        "A5": "0-2^2",
        "B5": "=0-2^2",
        "A6": "2+3*4",
        "B6": "=2+3*4",
        "A7": "(2+3)*4",
        "B7": "=(2+3)*4",
        "A8": "10-4-3",
        "B8": "=10-4-3",
        "A9": "12/4/3",
        "B9": "=12/4/3",
        "A10": "2^-1",
        "B10": "=2^-1",
        "A11": "2*3^2",
        "B11": "=2*3^2",
        "A12": "-2^3",
        "B12": "=-2^3",
        "A13": "1+2=3",
        "B13": "=1+2=3",
        "A14": "1<2<3",
        "B14": "=1<2<3",
        "A15": "2^0.5",
        "B15": "=2^0.5"
      }
    },
    {
      "id": "rounding",
      "title": "Rounding",
      "cells": {
        "A1": "Value",
        "B1": "Rounded",
        "A2": "2.5",
        "B2": "=ROUND(A2,0)",
        "A3": "-2.5",
        "B3": "=ROUND(A3,0)",
        "A4": "1234.5",
        "B4": "=ROUND(A4,-2)",
        "A5": "0.125",
        "B5": "=ROUND(A5,2)",
        "A6": "-0.125",
        "B6": "=ROUND(A6,2)",
        "A7": "1250",
        "B7": "=ROUND(A7,-2)",
        "A8": "49",
        "B8": "=ROUND(A8,-2)",
        "A9": "2.345",
        "B9": "=ROUND(A9,2.9)",
        "A10": "-7.45",
        "B10": "=ROUND(A10,-1.7)",
        "B11": "=ROUND(A11,1)",
        "A12": "=1/3",
        "B12": "=ROUND(A12,4)",
        "A13": "'2.5",
        "B13": "=ROUND(A13,0)",
        "A14": "Check",
        "B14": "=ABS(B3)+ABS(B6)",
        "A15": "Total",
        "B15": "=SUM(B2:B13)"
      }
    },
    {
      "id": "error-showcase",
      "title": "Error showcase",
      "cells": {
        "A1": "10",
        "B1": "=A1/A2",
        "A2": "0",
        "B2": "=A1+A3",
        "A3": "abc",
        "B3": "=A4*2",
        "A4": "'12",
        "B4": "=SQRT(A1)",
        "A5": "TRUE",
        "B5": "=A1^0.5",
        "B6": "=A2^0",
        "B7": "=A2^-1",
        "B8": "=A3+A1/A2",
        "B9": "=A1/A2+A3",
        "B10": "=IFERROR(B1,-1)",
        "B11": "=IF(A2=0,\"n/a\",A1/A2)",
        "B12": "=IF(A2<>0,A1/A2)",
        "B13": "=AVERAGE(A3:A4)",
        "B14": "=ROUND(A1)",
        "B15": "=IF(A3,1,2)",
        "B16": "=IFERROR(SQRT(4),\"no sqrt\")",
        "B17": "=SUM(A1:A5)",
        "B18": "=A1+A5",
        "B19": "=MIN(A3:A4)",
        "B20": "=ABS(A1:A2)",
        "B21": "=A1*Rate",
        "B22": "=SUM(A1,B5,B1)",
        "B23": "=IFERROR(A1*2,0)"
      }
    },
    {
      "id": "circular-refs",
      "title": "Circular references",
      "cells": {
        "A1": "=A2+1",
        "B1": "=B2+1",
        "C1": "=C1+1",
        "D1": "=A1*2",
        "E1": "5",
        "A2": "=A1*2+E1",
        "B2": "=B3+1",
        "C2": "=IF(FALSE,C2,5)",
        "D2": "=IFERROR(A1,-1)",
        "E2": "1",
        "B3": "=B1+1",
        "D3": "=IF(TRUE,7,B1)",
        "E3": "2",
        "D4": "=SUM(B1:B3)",
        "E4": "=SUM(E1:E4)",
        "D5": "=D1+1",
        "E5": "=SUM(E1:E3)",
        "D6": "=IFERROR(D5,0)"
      }
    },
    {
      "id": "text-and-booleans",
      "title": "Text and booleans",
      "cells": {
        "A1": "Apple",
        "B1": "=A1=A2",
        "A2": "APPLE",
        "B2": "=A3>A1",
        "A3": "banana",
        "B3": "=A7<A1",
        "A4": "TRUE",
        "B4": "=A1<A4",
        "A5": "FALSE",
        "B5": "=A4+A4",
        "A6": "'12",
        "B6": "=A8=\"\"",
        "A7": "7",
        "B7": "=A8=0",
        "B8": "=A8=FALSE",
        "B9": "=A6=12",
        "B10": "=A6+1",
        "B11": "=SUM(A1:A8)",
        "B12": "=COUNT(A1:A8)",
        "B13": "=SUM(A4,A5,A7)",
        "B14": "=SUM(TRUE,FALSE,A7)",
        "B15": "=NOT(A7)",
        "B16": "=AND(A4,A7,1)",
        "B17": "=OR(A5,A8)",
        "B18": "=IF(A7>5,\"big\",\"small\")",
        "B19": "=\"say \"\"hi\"\"\"",
        "B20": "=A4=TRUE",
        "B21": "=IF(A8,\"set\",\"blank\")",
        "B22": "=AND(A1)",
        "B23": "=A8"
      }
    },
    {
      "id": "gradebook",
      "title": "Gradebook",
      "cells": {
        "A1": "Student",
        "B1": "Quiz",
        "C1": "Exam",
        "D1": "Final",
        "E1": "Grade",
        "A2": "Ines",
        "B2": "88",
        "C2": "92",
        "D2": "=ROUND((B2+2*C2)/3,1)",
        "E2": "=IF(D2>=90,\"A\",IF(D2>=80,\"B\",\"C\"))",
        "A3": "Kofi",
        "B3": "79",
        "C3": "85",
        "D3": "=ROUND((B3+2*C3)/3,1)",
        "E3": "=IF(D3>=90,\"A\",IF(D3>=80,\"B\",\"C\"))",
        "A4": "Lena",
        "C4": "70",
        "D4": "=ROUND((B4+2*C4)/3,1)",
        "E4": "=IF(D4>=90,\"A\",IF(D4>=80,\"B\",\"C\"))",
        "A5": "Mateo",
        "B5": "excused",
        "C5": "95",
        "D5": "=ROUND((B5+2*C5)/3,1)",
